#!/bin/sh
set -e

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

# --- Check of the embedded Python environment --------------------------------
# Planche-Contact ships its Python dependencies (Pillow, reportlab, rawpy,
# exifread) in a virtualenv built when the package is created. In theory,
# this venv works identically on any amd64 machine. In practice, some compiled
# libraries (rawpy in particular) may fail to load on an unusual distribution
# or system configuration. So we check here, at install time, that everything
# imports correctly, rather than letting the user discover the problem the
# first time the application is launched.

VENV_PYTHON="/usr/share/planche-contact/venv/bin/python3"

if [ ! -x "$VENV_PYTHON" ]; then
    echo "" >&2
    echo "Planche-Contact error: the embedded Python environment cannot be found" >&2
    echo "($VENV_PYTHON is missing or not executable)." >&2
    echo "" >&2
    echo "The .deb package appears to be incomplete or corrupted." >&2
    echo "" >&2
    echo "Solution: download the package again from:" >&2
    echo "    https://github.com/gillesmagneville/planche-contact/releases" >&2
    echo "then reinstall it." >&2
    echo "" >&2
    echo "The installation is cancelled." >&2
    exit 1
fi

CHECK_LOG=$(mktemp)
if "$VENV_PYTHON" -c "import PIL, reportlab, rawpy, exifread" >"$CHECK_LOG" 2>&1; then
    rm -f "$CHECK_LOG"
else
    echo "" >&2
    echo "Planche-Contact error: a required library could not be loaded" >&2
    echo "on this system." >&2
    echo "" >&2
    echo "Error details:" >&2
    sed 's/^/    /' "$CHECK_LOG" >&2
    rm -f "$CHECK_LOG"
    echo "" >&2
    echo "Probable cause: your distribution or your architecture is not" >&2
    echo "compatible with one of the precompiled libraries embedded in" >&2
    echo "the package (RAW file support, in particular, depends on system" >&2
    echo "libraries such as liblcms2 or libjpeg)." >&2
    echo "" >&2
    echo "To fix the problem, try the following in order:" >&2
    echo "" >&2
    echo "    1) Reinstall the embedded Python libraries:" >&2
    echo "         sudo /usr/share/planche-contact/venv/bin/pip install --force-reinstall rawpy exifread Pillow reportlab" >&2
    echo "       then run the package installation again." >&2
    echo "" >&2
    echo "    2) If the problem persists, report it by copying this error" >&2
    echo "       message into an issue here:" >&2
    echo "         https://github.com/gillesmagneville/planche-contact/issues" >&2
    echo "" >&2
    echo "The installation is cancelled." >&2
    exit 1
fi

# --- Nautilus context menu --------------------------------------------------
# Restarts Nautilus if it is running, so that it reloads the list of Python
# extensions and shows "Open in Planche-Contact" immediately (otherwise the
# entry only appears at the next login). Only done when the extension is
# there AND nautilus-python (python3-nautilus, a recommended dependency) is
# installed: without it, restarting Nautilus would change nothing.
#
# The message follows the system language: English, French, Spanish or
# German, falling back to English. The language is chosen by the same rules
# as gettext (and therefore as the menu entry itself): take the first
# non-empty variable among LANGUAGE, LC_ALL, LC_MESSAGES and LANG; it may
# hold several languages separated by ":", the first available language
# wins; "C" and "POSIX" stop the search (English).
# This block is deliberately identical to nautilus-convert-images's postinst.
pick_language() {
    _lang=en
    _list=
    for _var in "${LANGUAGE:-}" "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
        if [ -n "$_var" ]; then
            _list=$_var
            break
        fi
    done
    _old_ifs=$IFS
    IFS=:
    set -f
    for _entry in $_list; do
        case $_entry in
            C | C.* | POSIX | POSIX.*) break ;;
            fr | fr_* | fr.* | fr@*) _lang=fr; break ;;
            es | es_* | es.* | es@*) _lang=es; break ;;
            de | de_* | de.* | de@*) _lang=de; break ;;
        esac
    done
    set +f
    IFS=$_old_ifs
    echo "$_lang"
}

if [ -f /usr/share/nautilus-python/extensions/planche_contact_nautilus.py ] \
    && dpkg -s python3-nautilus >/dev/null 2>&1 \
    && command -v nautilus >/dev/null 2>&1; then
    if pgrep -x nautilus >/dev/null 2>&1; then
        nautilus -q >/dev/null 2>&1 || true
        case "$(pick_language)" in
            fr) echo "planche-contact : Nautilus a été redémarré pour activer l'entrée de menu « Ouvrir dans Planche-Contact »." ;;
            es) echo "planche-contact: Nautilus se ha reiniciado para activar la entrada de menú «Abrir en Planche-Contact»." ;;
            de) echo "planche-contact: Nautilus wurde neu gestartet, um den Menüeintrag „In Planche-Contact öffnen“ zu aktivieren." ;;
            *)  echo "planche-contact: Nautilus was restarted to enable the \"Open in Planche-Contact\" menu entry." ;;
        esac
    fi
fi

exit 0

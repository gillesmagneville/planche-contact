#!/bin/sh
set -e

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

# --- Check of the embedded Python environment --------------------------------
# Planche-Contact ships its Python dependencies (Pillow, reportlab, rawpy,
# exifread) in a virtualenv built when the package is created. In theory,
# this venv works identically on any amd64 machine. In practice, some compiled
# libraries (rawpy in particular) may fail to load on an unusual distribution
# or system configuration. So we check here, at install time, that everything
# imports correctly, rather than letting the user discover the problem the
# first time the application is launched.

VENV_PYTHON="/usr/share/planche-contact/venv/bin/python3"

if [ ! -x "$VENV_PYTHON" ]; then
    echo "" >&2
    echo "Planche-Contact error: the embedded Python environment cannot be found" >&2
    echo "($VENV_PYTHON is missing or not executable)." >&2
    echo "" >&2
    echo "The .deb package appears to be incomplete or corrupted." >&2
    echo "" >&2
    echo "Solution: download the package again from:" >&2
    echo "    https://github.com/gillesmagneville/planche-contact/releases" >&2
    echo "then reinstall it." >&2
    echo "" >&2
    echo "The installation is cancelled." >&2
    exit 1
fi

CHECK_LOG=$(mktemp)
if "$VENV_PYTHON" -c "import PIL, reportlab, rawpy, exifread" >"$CHECK_LOG" 2>&1; then
    rm -f "$CHECK_LOG"
else
    echo "" >&2
    echo "Planche-Contact error: a required library could not be loaded" >&2
    echo "on this system." >&2
    echo "" >&2
    echo "Error details:" >&2
    sed 's/^/    /' "$CHECK_LOG" >&2
    rm -f "$CHECK_LOG"
    echo "" >&2
    echo "Probable cause: your distribution or your architecture is not" >&2
    echo "compatible with one of the precompiled libraries embedded in" >&2
    echo "the package (RAW file support, in particular, depends on system" >&2
    echo "libraries such as liblcms2 or libjpeg)." >&2
    echo "" >&2
    echo "To fix the problem, try the following in order:" >&2
    echo "" >&2
    echo "    1) Reinstall the embedded Python libraries:" >&2
    echo "         sudo /usr/share/planche-contact/venv/bin/pip install --force-reinstall rawpy exifread Pillow reportlab" >&2
    echo "       then run the package installation again." >&2
    echo "" >&2
    echo "    2) If the problem persists, report it by copying this error" >&2
    echo "       message into an issue here:" >&2
    echo "         https://github.com/gillesmagneville/planche-contact/issues" >&2
    echo "" >&2
    echo "The installation is cancelled." >&2
    exit 1
fi

exit 0
